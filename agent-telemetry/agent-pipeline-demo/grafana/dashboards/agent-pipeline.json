{
  "title": "Agent Pipeline Telemetry",
  "uid": "agent-pipeline",
  "version": 2,
  "schemaVersion": 39,
  "refresh": "10s",
  "panels": [
    {
      "id": 1, "title": "Pipeline Request Rate (req/min)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [{ "datasource": "Prometheus",
        "expr": "rate(http_requests_total{handler='/api/pipeline'}[1m]) * 60",
        "legendFormat": "requests/min" }]
    },
    {
      "id": 2, "title": "LLM Latency P99 by Agent (seconds)", "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "targets": [{ "datasource": "Prometheus",
        "expr": "histogram_quantile(0.99, rate(llm_latency_seconds_bucket[5m]))",
        "legendFormat": "p99 {{service}} / {{agent_role}}" }]
    },
    {
      "id": 3, "title": "Cumulative LLM Cost (USD)", "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "targets": [{ "datasource": "Prometheus",
        "expr": "llm_cost_usd_total",
        "legendFormat": "{{service}} / {{agent_role}}" }]
    },
    {
      "id": 4, "title": "LLM Cost Rate (USD/min)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "datasource": "Prometheus",
        "expr": "rate(llm_cost_usd_total[1m]) * 60",
        "legendFormat": "$/min {{service}}" }]
    },
    {
      "id": 5, "title": "RAG Relevance Score (p50 / p95)", "type": "timeseries",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "targets": [
        { "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(rag_relevance_score_bucket[5m]))",
          "legendFormat": "p50 relevance" },
        { "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(rag_relevance_score_bucket[5m]))",
          "legendFormat": "p95 relevance" }
      ]
    },
    {
      "id": 6, "title": "RAG Chunks Retrieved per Query", "type": "timeseries",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "datasource": "Prometheus",
        "expr": "histogram_quantile(0.50, rate(rag_chunks_retrieved_bucket[5m]))",
        "legendFormat": "median chunks/query" }]
    },
    {
      "id": 7, "title": "Hallucination Risk Events by Level", "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "targets": [{ "datasource": "Prometheus",
        "expr": "rate(hallucination_risk_total[5m]) * 60",
        "legendFormat": "{{risk_level}}" }]
    },
    {
      "id": 8, "title": "LLM Retry Rate (retries/min)", "type": "timeseries",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "targets": [{ "datasource": "Prometheus",
        "expr": "rate(llm_retries_total[5m]) * 60",
        "legendFormat": "retries/min {{service}}" }]
    },
    {
      "id": 9, "title": "LLM Error Rate by Type", "type": "timeseries",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "targets": [{ "datasource": "Prometheus",
        "expr": "rate(llm_errors_total[5m]) * 60",
        "legendFormat": "{{error_type}} / {{service}}" }]
    },
    {
      "id": 10, "title": "LLM Latency P50 / P95 / P99 (all agents)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        { "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(llm_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50" },
        { "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(llm_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95" },
        { "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(llm_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99" }
      ]
    },
    {
      "id": 11, "title": "HTTP 5xx Error Rate", "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [{ "datasource": "Prometheus",
        "expr": "rate(http_requests_total{status=~'5..'}[1m]) * 60",
        "legendFormat": "5xx/min {{handler}}" }]
    }
  ]
}
